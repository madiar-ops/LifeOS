# ============================================================
# LifeOS AI Service — пример переменных окружения
# Скопируй в .env и подставь значения. .env в git НЕ коммитится.
# ============================================================

ENVIRONMENT=Development
DEBUG=true

# Общий секрет канала ASP.NET Core -> FastAPI.
# ОБЯЗАТЕЛЕН: без него сервис отвечает 500 на все защищённые эндпоинты.
# Должен совпадать со значением на стороне backend.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=

# Порог доверия: ниже него ответ помечается is_confident=false
CONFIDENCE_THRESHOLD=0.60

# Внешний LLM для конспектов и разбора резюме.
# Пусто — модули работают на локальных алгоритмах (тесты будут недоступны).
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=60

# Список origin через запятую. Пусто — браузер сюда не ходит (штатный режим).
CORS_ORIGINS=

# ============================================================
# LifeOS — переменные окружения
#
# Скопируй в .env и заполни. Файл .env в git НЕ коммитится.
# Для локальной разработки из IDE секреты backend удобнее держать
# в user-secrets, а не здесь — .env нужен прежде всего для
# docker compose.
# ============================================================

# ---- PostgreSQL (локально) ----------------------------------
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

# ---- Backend ------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=8080

# Локально:
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=lifeos;Username=lifeos;Password=change_me_locally
# Neon (production) — обязательно с SSL:
# ConnectionStrings__DefaultConnection=Host=<neon-host>;Database=lifeos;Username=<user>;Password=<pass>;SSL Mode=Require;Trust Server Certificate=true

# Минимум 32 символа. Сгенерировать:
#   openssl rand -base64 48
JWT_KEY=

# ---- AI Service ---------------------------------------------
# ОДНО И ТО ЖЕ значение для backend и ai-service.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=

# Необязателен: без него Study и Career работают на локальных алгоритмах.
LLM_API_KEY=
CONFIDENCE_THRESHOLD=0.60

# ---- Firebase Storage ---------------------------------------
# Пусто — включается локальное хранилище (только для разработки).
FIREBASE_BUCKET=
# Содержимое JSON сервисного аккаунта одной строкой (для облака).
FIREBASE_CREDENTIALS_JSON=

# ---- Frontend -----------------------------------------------
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080

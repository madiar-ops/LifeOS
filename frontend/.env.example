# Базовый URL ASP.NET Core Web API.
# Разработка (профиль LifeOS.API из launchSettings.json):
VITE_API_BASE_URL=https://localhost:7001/api

# Если сертификат разработки не удаётся сделать доверенным, есть два пути:
#   1) HTTP-эндпоинт бэкенда (в Development HTTPS-редирект отключён):
#      VITE_API_BASE_URL=http://localhost:5001/api
#   2) dev-proxy Vite (раскомментируй блок server.proxy в vite.config.ts):
#      VITE_API_BASE_URL=/api

VITE_APP_NAME=LifeOS
